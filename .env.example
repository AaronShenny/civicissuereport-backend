# Gemini model identifier. Default: gemini-3.6-flash (GA/stable, released July 21, 2026).
# Update this env var when a newer model is available — no code changes required.
AI_GEMINI_MODEL=gemini-3.6-flash

# Confidence threshold (0-100) for routing low-confidence AI classifications
# to classification_review_tasks for manual human review.
# NOTE: 70.0 is an application-level default, not an authoritative business rule.
AI_CONFIDENCE_THRESHOLD=70.0
